RewriteEngine On

# ============================================================
# 0. УБИРАЕМ WWW (301 REDIRECT)
# ============================================================
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
# Если у вас подключен SSL (HTTPS), замените http:// на https:// в строке выше


# ============================================================
# 1. 301 REDIRECT: /page.html -> /page
# ============================================================

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]


# ============================================================
# 2. ЕСЛИ ЗАПРОШЕННЫЙ ПУТЬ УЖЕ ЯВЛЯЕТСЯ ФАЙЛОМ —
#    ОТДАЁМ ЕГО БЕЗ ПЕРЕЗАПИСИ
# ============================================================

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]


# ============================================================
# 3. ЕСЛИ СУЩЕСТВУЕТ ФАЙЛ page.html —
#    /page -> /page.html
#
#    Приоритет .html выше одноимённой папки.
# ============================================================

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]


# ============================================================
# 4. СУЩЕСТВУЮЩИЕ КАТАЛОГИ НЕ ПЕРЕПИСЫВАЕМ
#
#    Apache сам обработает DirectoryIndex и / в конце URL.
# ============================================================

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ============================================================
# 5. КАСТОМНАЯ СТРАНИЦА 404
# ============================================================

ErrorDocument 404 /404.html